# Copy to .env for local runs. In GitHub Actions, add these as repository secrets.

# Comma-separated: x,threads,instagram
ENABLED_PLATFORMS=x,threads,instagram

# Keep true for production. Set false only if you intentionally allow partial posting.
REQUIRE_ALL_PLATFORMS=true

# Optional override for testing, format YYYY-MM-DD. Leave empty in production.
POST_DATE=

# Content generation source. Use static for the free prewritten content bank.
# Use openai only after explicitly approving OpenAI API costs.
CONTENT_SOURCE=static
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1400
OPENAI_API_APPROVED=false

# X / Twitter API v2 OAuth 2.0 user-context token with tweet.write permission.
X_BEARER_TOKEN=

# Threads API. The user id is usually the Threads user id returned by Meta APIs.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Instagram Graph API. Requires an Instagram professional account connected to a Facebook Page.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Instagram feed publishing requires a publicly reachable JPG/PNG URL.
# You can use a GitHub raw URL, CDN URL, or your website-hosted daily/static brand image.
INSTAGRAM_IMAGE_URL=

# Meta Graph API version for Instagram Graph API calls.
GRAPH_API_VERSION=v21.0
