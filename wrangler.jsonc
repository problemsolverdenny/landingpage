{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "problemsolverdenny",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-05-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
